Subject: [PATCH] Enable Python bindings for cross-compile (Yocto build)

Upstream disables USE_PYTHON for cross-compilation. In the Yocto/OE build we
provide the target Python and build the dx_engine C-API (pybind11) module at
build time, so force-enable USE_PYTHON for cross builds and add the capi
subdirectory.

Upstream-Status: Inappropriate [Yocto cross-compile specific configuration]

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -41,8 +41,8 @@
     set(CROSS_COMPILE TRUE)
 endif()
 if(CROSS_COMPILE)
-    set(USE_PYTHON OFF)
-    message(STATUS "  USE_PYTHON is disabled for cross compile case in current version.")
+    set(USE_PYTHON ON)
+    message(STATUS "  USE_PYTHON is ensabled for cross compile case in current version. (for yocto)")
 endif()
 
 # cmake options
@@ -270,7 +270,10 @@
     # find python library
     include_directories(${PYTHON_INCLUDE_DIRS})
     # include_directories(/usr/include/eigen3)
-    add_compile_definitions(USE_PYTHON) 
+    add_compile_definitions(USE_PYTHON)
+
+    # python module compile in build time
+    add_subdirectory(python_package/src/dx_engine/capi)
 
 endif()
 
